def normalize_text(text: str) -> str:
    if not text:
        return ""
    text = unicodedata.normalize("NFKC", text)
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    text = text.replace("\xa0", " ")
    text = re.sub(r"([A-Za-z])-\n([A-Za-z])", r"\1\2", text)

    paragraphs = re.split(r"\n\s*\n", text)
    cleaned = []
    for p in paragraphs:
        p = re.sub(r"[ \t]*\n[ \t]*", " ", p.strip())
        p = re.sub(r"\s{2,}", " ", p)
        if p:
            cleaned.append(p)

    text = "\n\n".join(cleaned)
    text = re.sub(r"[ \t]+", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()



def safe_stem(name: str) -> str:
    stem = Path(name).stem
    for ch in [" ", "/", "\\", ":", "*", "?", '"', "<", ">", "|"]:
        stem = stem.replace(ch, "_")
    return stem


def detect_language_hint(text: str) -> str:
    if not text:
        return "unknown"
    hangul = sum(1 for ch in text if "\uac00" <= ch <= "\ud7a3")
    latin = sum(1 for ch in text if ch.isascii() and ch.isalpha())
    if hangul > latin:
        return "ko"
    if latin > hangul:
        return "en"
    return "mixed"


def estimate_noise_score(text: str) -> dict:
    if not text:
        return {"score": 100.0, "level": "EMPTY", "usable": False, "reason": "empty text", "metrics": {}}

    chars = len(text)
    lines = [ln for ln in text.split("\n") if ln.strip()]
    line_count = max(1, len(lines))
    letters = sum(1 for ch in text if ch.isalpha())
    digits = sum(1 for ch in text if ch.isdigit())
    control = sum(1 for ch in text if ord(ch) < 32 and ch not in "\n\t")
    replacement = text.count("")

    short_lines = sum(1 for ln in lines if len(ln.strip()) < 20)
    short_line_ratio = short_lines / line_count

    repeat_runs = 0
    prev = ""
    run = 0
    for ch in text:
        if ch == prev:
            run += 1
        else:
            run = 1
            prev = ch
        if run >= 5:
            repeat_runs += 1

    alpha_ratio = letters / chars
    digit_ratio = digits / chars
    ctrl_ratio = control / chars
    repl_ratio = replacement / chars

    score = 0.0
    score += max(0, (1 - alpha_ratio)) * 12
    score += min(1, digit_ratio * 3) * 6
    score += min(1, ctrl_ratio * 25) * 35
    score += min(1, repl_ratio * 40) * 40
    score += min(1, short_line_ratio) * 10
    score += min(1, repeat_runs / 20) * 8
    score = max(0.0, min(100.0, score))

    if score >= 70:
        level, usable = "HIGH", False
    elif score >= 40:
        level, usable = "MEDIUM", True
    elif score >= 15:
        level, usable = "LOW", True
    else:
        level, usable = "GOOD", True

    reason = "ok"
    if replacement > 0:
        reason = "replacement chars detected"
    elif control > 0:
        reason = "control chars detected"
    elif short_line_ratio > 0.5:
        reason = "many short lines"
    elif repeat_runs > 0:
        reason = "repeated patterns detected"

    return {
        "score": round(score, 1),
        "level": level,
        "usable": usable,
        "reason": reason,
        "metrics": {
            "chars": chars,
            "alpha_ratio": round(alpha_ratio, 3),
            "digit_ratio": round(digit_ratio, 3),
            "ctrl_ratio": round(ctrl_ratio, 3),
            "repl_ratio": round(repl_ratio, 3),
            "short_line_ratio": round(short_line_ratio, 3),
            "repeat_runs": repeat_runs,
        },
    }


def score_to_color(score: float) -> str:
    if score >= 70:
        return "#e74c3c"
    if score >= 40:
        return "#f39c12"
    if score >= 15:
        return "#f1c40f"
    return "#2ecc71"


def score_to_label(score: float) -> str:
    if score >= 70:
        return "HIGH NOISE"
    if score >= 40:
        return "MEDIUM NOISE"
    if score >= 15:
        return "LOW NOISE"
    return "GOOD"


def append_event(event, status="DONE", delta=5, note="", run_id="manual"):
    ensure_dirs()
    entry = {
        "event": event,
        "status": status,
        "delta": delta,
        "note": note,
        "run_id": run_id,
        "ts": pd.Timestamp.now().isoformat(timespec="seconds"),
    }
    try:
        with EVENTS_JSONL.open("a", encoding="utf-8") as f:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except Exception as e:
        safe_log_exception(f"event write failed: {e}")
    try:
        df = load_progress_df()
        area = EVENT_TO_AREA.get(event)
        if area and area in set(df["영역"]):
            i = df.index[df["영역"] == area][0]
            current = int(df.at[i, "진행률"])
            if status == "DONE":
                current = min(100, current + delta)
                df.at[i, "상태"] = "DONE" if current >= 100 else "DOING"
            else:
                df.at[i, "상태"] = status
            df.at[i, "진행률"] = current
            save_progress_df(df)
            refresh_todo_doc(df)
        return df
    except Exception as e:
        safe_log_exception(f"append_event failed: {e}")
    return load_progress_df()


def load_progress_df():
    ensure_dirs()
    if PROGRESS_CSV.exists():
        try:
            return pd.read_csv(PROGRESS_CSV)
        except Exception:
            pass
    df = pd.DataFrame(DEFAULT_PROGRESS)
    df.to_csv(PROGRESS_CSV, index=False)
    return df


def save_progress_df(df):
    ensure_dirs()
    df.to_csv(PROGRESS_CSV, index=False)


def refresh_todo_doc(df=None):
    try:
        ensure_dirs()
        if df is None:
            df = load_progress_df()
        avg = float(df["진행률"].mean()) if not df.empty else 0.0
        todo = int((df["상태"] == "TODO").sum())
        blocked = int((df["상태"] == "BLOCKED").sum())
        auto = [
            "",
            "---",
            "## Auto Summary",
            f"- 전체 평균 진행률: {avg:.1f}%",
            f"- TODO 수: {todo}",
            f"- BLOCKED 수: {blocked}",
            "",
            "### 영역별 상태",
        ]
        for _, row in df.iterrows():
            auto.append(f"- {row['영역']}: {int(row['진행률'])}% / {row['상태']}")
        if TODO_MD.exists():
            base = TODO_MD.read_text(encoding="utf-8").split("\n---\n## Auto Summary")[0].rstrip()
        else:
            base = "# DBMAr Project State\n\n이 파일은 프로젝트 모니터링의 기준 문서입니다."
        TODO_MD.write_text(base + "\n" + "\n".join(auto) + "\n", encoding="utf-8")
    except Exception as e:
        safe_log_exception(f"refresh_todo_doc failed: {e}")


def render_production_rag_tab(
    embed_model: str,
    gen_model: str,
    chunk_size: int,
    chunk_overlap: int,
    top_k: int,
    temperature: float,
):
    st.subheader("Production RAG Console")
    st.caption(
        f"embed={embed_model}, gen={gen_model}, chunk_size={chunk_size}, "
        f"chunk_overlap={chunk_overlap}, top_k={top_k}, temperature={temperature}"
    )

    if "rag_query" not in st.session_state:
        st.session_state.rag_query = ""
    if "rag_answer" not in st.session_state:
        st.session_state.rag_answer = ""
    if "rag_contexts" not in st.session_state:
        st.session_state.rag_contexts = []
    if "rag_sources" not in st.session_state:
        st.session_state.rag_sources = []
    if "rag_status" not in st.session_state:
        st.session_state.rag_status = ""
    if "rag_busy" not in st.session_state:
        st.session_state.rag_busy = False
    if "rag_pending" not in st.session_state:
        st.session_state.rag_pending = None

    selected_docs = pick_docs_for_embedding()
    if selected_docs:
        st.caption(f"선택된 파일: {len(selected_docs)}개")
    else:
        st.caption("선택된 파일이 없으면 전체 문서를 대상으로 동작합니다.")

    left, right = st.columns([3, 1])
    with left:
        query = st.text_area(
            "질문",
            value=st.session_state.rag_query,
            height=120,
            placeholder="예: 이 본문의 핵심 논지와 적용점을 요약해 주세요.",
        )
    with right:
        st.markdown("### Actions")
        ask_clicked = st.button("질의 실행", use_container_width=True, disabled=st.session_state.rag_busy)
        index_clicked = st.button("인덱스 반영", use_container_width=True, disabled=st.session_state.rag_busy)
        reset_clicked = st.button("인덱스 초기화", use_container_width=True, disabled=st.session_state.rag_busy)
        clear_clicked = st.button("결과 초기화", use_container_width=True, disabled=st.session_state.rag_busy)

    action = None
    if clear_clicked:
        action = "clear"
    elif reset_clicked:
        action = "reset"
    elif index_clicked:
        action = "index"
    elif ask_clicked and query.strip():
        action = "ask"

    if action == "clear":
        st.session_state.rag_query = ""
        st.session_state.rag_answer = ""
        st.session_state.rag_contexts = []
        st.session_state.rag_sources = []
        st.session_state.rag_status = "결과를 초기화했습니다."
        st.session_state.rag_busy = False
        st.session_state.rag_pending = None
        st.rerun()

    if action == "reset":
        st.session_state.rag_busy = True
        st.session_state.rag_pending = "reset"
        st.rerun()

    if action == "index":
        st.session_state.rag_query = query.strip()
        st.session_state.rag_busy = True
        st.session_state.rag_pending = "index"
        st.rerun()

    if st.session_state.rag_pending == "reset":
        with st.spinner("인덱스를 초기화하는 중..."):
            logs = reset_index(str(CHROMA_DIR))
        st.session_state.rag_status = " | ".join(logs)
        st.session_state.rag_pending = None
        st.session_state.rag_busy = False
        st.rerun()

    if st.session_state.rag_pending == "index":
        with st.spinner("인덱스에 반영하는 중..."):
            logs = build_index(str(OUTPUT_DIR), str(CHROMA_DIR), force=True)
        st.session_state.rag_status = " | ".join(logs)
        st.session_state.rag_pending = None
        st.session_state.rag_busy = False
        st.rerun()

    if st.session_state.rag_pending == "ask":
        st.session_state.rag_query = query.strip()
        with st.spinner("검색 및 응답 생성 중..."):
            hits = retrieve(
                query.strip(),
                persist_dir=str(CHROMA_DIR),
                top_k=top_k,
                exclude_noisy=True,
                noise_threshold=RAG_MAX_NOISE,
            )
            answer = generate_answer(
                query.strip(),
                hits,
                gen_model,
                ollama_host if "ollama_host" in globals() else "http://localhost:11434",
            )
        st.session_state.rag_answer = answer
        st.session_state.rag_contexts = [h.get("text", "") for h in hits]
        st.session_state.rag_sources = [
            {
                "rank": i + 1,
                "id": h.get("id", ""),
                "source": h.get("meta", {}).get("source", "unknown"),
                "chunk": h.get("meta", {}).get("chunk_index", h.get("meta", {}).get("chunk", i)),
                "noise": h.get("meta", {}).get("noise", None),
                "snippet": h.get("text", "")[:240].replace("\n", " "),
            }
            for i, h in enumerate(hits)
        ]
        st.session_state.rag_status = f"검색 완료: {len(hits)}개 후보"
        st.session_state.rag_pending = None
        st.session_state.rag_busy = False
        st.rerun()

    if st.session_state.rag_status:
        st.info(st.session_state.rag_status)

    if st.session_state.rag_answer:
        st.markdown("### Answer")
        st.write(st.session_state.rag_answer)

    if st.session_state.rag_sources:
        st.markdown("### Sources")
        st.dataframe(pd.DataFrame(st.session_state.rag_sources), use_container_width=True, hide_index=True)

    if st.session_state.rag_contexts:
        with st.expander("Retrieved Contexts", expanded=False):
            for i, ctx in enumerate(st.session_state.rag_contexts, start=1):
                st.markdown(f"**Context {i}**")
                st.write(ctx)

    st.markdown("---")
    st.caption("Operational RAG Console is backed by dbma_rag.py.")




def cleanup_cache():
    for fn in ("clear", "cache_data"):
        obj = getattr(st, fn, None)
        if callable(obj):
            try:
                obj.clear()
            except Exception as e:
                safe_log_exception(f"cleanup_cache {fn} failed: {e}")




def extract_pdf(path: Path, use_ocr: bool = False) -> str:
    opts = PdfPipelineOptions()
    opts.do_ocr = use_ocr
    if use_ocr:
        opts.ocr_options = EasyOcrOptions()
    converter = DocumentConverter(format_options={InputFormat.PDF: PdfFormatOption(pipeline_options=opts)})
    result = converter.convert(str(path))
    doc = getattr(result, "document", None)
    if doc is None:
        return ""
    text = getattr(doc, "export_to_markdown", None)
    if callable(text):
        return text()
    text = getattr(doc, "text", "")
    return text or ""


def extract_txt(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="ignore")


def extract_md(path: Path) -> str:
    return path.read_text(encoding="utf-8", errors="ignore")


def extract_docx(path: Path) -> str:
    doc = Document(str(path))
    return "\n".join(p.text for p in doc.paragraphs)


def extract_html(path: Path) -> str:
    html = path.read_text(encoding="utf-8", errors="ignore")
    soup = BeautifulSoup(html, "html.parser")
    return soup.get_text("\n")


def extract_rtf(path: Path) -> str:
    data = path.read_text(encoding="utf-8", errors="ignore")
    return rtf_to_text(data)


def extract_epub(path: Path) -> str:
    book = epub.read_epub(str(path))
    chunks = []
    for item in book.get_items():
        if item.get_type() == ITEM_DOCUMENT:
            try:
                soup = BeautifulSoup(item.get_content(), "html.parser")
                chunks.append(soup.get_text("\n"))
            except Exception:
                pass
    return "\n".join(chunks)


def extract_text(path: Path, use_ocr: bool = False) -> str:
    ext = path.suffix.lower()
    if ext == ".pdf":
        return extract_pdf(path, use_ocr=use_ocr)
    if ext == ".txt":
        return extract_txt(path)
    if ext == ".md":
        return extract_md(path)
    if ext == ".docx":
        return extract_docx(path)
    if ext == ".epub":
        return extract_epub(path)
    if ext in {".html", ".htm"}:
        return extract_html(path)
    if ext == ".rtf":
        return extract_rtf(path)
    return ""


def clean_text(text: str) -> str:
    _ABBREVIATIONS = {
    "e.g.", "i.e.", "etc.", "Dr.", "Mr.", "Mrs.", "Ms.", "Prof.",
    "Fig.", "No.", "Vol.", "Rev.", "St.", "cf.", "vs.", "et al."
}

def split_sentences(text: str) -> list[str]:
    text = (text or "").strip()
    if not text:
        return []
    protected = {}
    for i, abbr in enumerate(_ABBREVIATIONS):
        key = f"__ABBR_{i}__"
        protected[key] = abbr
        text = text.replace(abbr, key)
    parts = re.split(r"(?<=[.!?])\s+(?=[A-Z(])", text)
    out = []
    for part in parts:
        for k, v in protected.items():
            part = part.replace(k, v)
        part = part.strip()
        if part:
            out.append(part)
    return out

def chunk_by_sentences(sentences: list[str], max_chars: int = 1200, overlap_sents: int = 1) -> list[str]:
    chunks = []
    buf = []
    buf_len = 0

    def flush():
        if buf:
            chunks.append(" ".join(buf).strip())

    for s in sentences:
        s = s.strip()
        if not s:
            continue
        if buf and buf_len + 1 + len(s) > max_chars:
            flush()
            if overlap_sents > 0 and chunks:
                tail = chunks[-1].split(". ")
                buf[:] = tail[-overlap_sents:] if len(tail) >= overlap_sents else tail
                buf_len = len(" ".join(buf))
            else:
                buf.clear()
                buf_len = 0
        buf.append(s)
        buf_len += len(s) + 1

    flush()
    return [c for c in chunks if c.strip()]


def chunk_text(text: str, chunk_size: int = None, chunk_overlap: int = None, doc_type: str = "default") -> tuple[list[str], dict]:
    from core.chunking_optimizer import chunk_once, optimize_chunks

    cleaned = clean_text(text)
    sentences = split_sentences(cleaned)

    if chunk_size and chunk_overlap:
        chunks = chunk_by_sentences(sentences, max_chars=chunk_size, overlap_sents=1)
        params = {
            "chunk_size": chunk_size,
            "chunk_overlap": chunk_overlap,
            "strategy": "sentence_aware",
            "doc_type": doc_type,
        }
        return chunks, params

    result = optimize_chunks(cleaned, doc_type)
    return result.chunks, result.params



def write_outputs(src: Path, text: str, chunks: list[str]):
    ensure_dirs()
    stem = safe_stem(src.name)
    md_path = OUTPUT_DIR / f"{stem}.md"
    chunk_path = OUTPUT_DIR / f"{stem}_chunks.txt"
    md_path.write_text(text, encoding="utf-8")
    chunk_path.write_text("\n\\n".join(f"[CHUNK {i+1}]\n{c}" for i, c in enumerate(chunks)), encoding="utf-8")
    return md_path, chunk_path


def move_source(src: Path):
    target = OUTPUT_DIR / src.name
    try:
        if src.resolve() == target.resolve():
            return target
        if target.exists():
            target = OUTPUT_DIR / f'{safe_stem(src.name)}_{pd.Timestamp.now().strftime("%Y%m%d%H%M%S")}{src.suffix}'
        src.rename(target)
        return target
    except Exception as e:
        safe_log_exception(f"move_source failed: {e}")
        return src


def scan_raw_files():
    ensure_dirs()
    files = []
    for p in RAW_DIR.iterdir():
        if p.is_file() and p.suffix.lower() in SUPPORTED_EXTS:
            files.append(p)
    return sorted(files, key=lambda x: x.name.lower())


def get_vector_client():
    return chromadb.PersistentClient(path=str(CHROMA_DIR))


def get_collection():
    client = get_vector_client()
    return client.get_or_create_collection(name=COLLECTION_NAME)


def rag_chunk_text(text: str, chunk_size: int = DEFAULT_CHUNK_SIZE, overlap: int = DEFAULT_CHUNK_OVERLAP) -> List[str]:
    cleaned = clean_text(text or "")
    sentences = split_sentences(cleaned)
    if not sentences:
        return []
    return chunk_by_sentences(sentences, max_chars=chunk_size, overlap_sents=1)



def read_indexable_docs(selected_files: Optional[List[str]] = None, input_dir: str = str(OUTPUT_DIR)) -> List[Dict[str, Any]]:
    base = Path(input_dir)
    docs = []
    if not base.exists():
        return docs
    allowed = set(selected_files or [])
    for p in sorted(base.glob("*.md")):
        if allowed and p.name not in allowed:
            continue
        try:
            docs.append({"source": p.name, "text": p.read_text(encoding="utf-8", errors="ignore")})
        except Exception:
            pass
    return docs


def list_ollama_models() -> List[str]:
    try:
        import requests
        r = requests.get("http://localhost:11434/api/tags", timeout=5)
        r.raise_for_status()
        data = r.json()
        return [m.get("name") for m in data.get("models", []) if m.get("name")]
    except Exception:
        return []


def _model_supports_embeddings(model: str) -> bool:
    name = (model or "").lower()
    keywords = ["embed", "bge", "nomic", "mxbai", "e5", "snowflake"]
    return any(k in name for k in keywords)


def _embed_texts(texts: List[str], model: str = DEFAULT_EMBED_MODEL) -> List[List[float]]:
    try:
        return ollama.embed(model=model, input=texts)["embeddings"]
    except Exception as e:
        if "tokenize" in str(e).lower() or len(texts) > 1:
            out = []
            for t in texts:
                if not t.strip():
                    continue
                try:
                    out.extend(ollama.embed(model=model, input=t)["embeddings"])
                except Exception:
                    continue
            if out:
                return out
        raise


def _rag_noise(text: str) -> float:
    return estimate_noise_score(text)["score"]

def build_rag_chunks(
    selected_files: Optional[List[str]] = None,
    input_dir: str = str(OUTPUT_DIR),
    chunk_size: int = DEFAULT_CHUNK_SIZE,
    min_len: int = RAG_MIN_LEN,
    max_noise: float = RAG_MAX_NOISE,
):
    docs = read_indexable_docs(selected_files=selected_files, input_dir=input_dir)
    ids, documents, metadatas = [], [], []

    for doc in docs:
        raw_text = doc["text"] or ""
        cleaned_text = clean_text(raw_text)
        sentences = split_sentences(cleaned_text)
        chunks = chunk_by_sentences(sentences, max_chars=chunk_size, overlap_sents=1)

        for j, chunk in enumerate(chunks):
            if len(chunk.strip()) < min_len:
                continue
            noise = _rag_noise(chunk)
            if noise >= max_noise:
                continue

            ids.append(f"{doc['source']}::{j}")
            documents.append(chunk)
            metadatas.append(
                {
                    "source": doc["source"],
                    "chunk_index": j,
                    "stage": "raw->cleaned->sentence->chunk",
                    "raw_chars": len(raw_text),
                    "cleaned_chars": len(cleaned_text),
                    "sentence_count": len(sentences),
                    "noise": noise,
                    "len": len(chunk),
                }
            )

    return {
        "documents": len(docs),
        "chunks": len(documents),
        "ids": ids,
        "documents_text": documents,
        "metadatas": metadatas,
    }


def embed_rag_chunks(documents: List[str], embed_model: str = DEFAULT_EMBED_MODEL):
    if not documents:
        return []
    return _embed_texts(documents, model=embed_model)


def upsert_rag_index(
    ids: List[str],
    documents: List[str],
    metadatas: List[dict],
    embeddings: List[List[float]],
):
    if not ids:
        return {"indexed": 0}
    collection = get_collection()
    collection.add(
        ids=ids,
        documents=documents,
        metadatas=metadatas,
        embeddings=embeddings,
    )
    return {"indexed": len(ids)}



def build_rag_store(
    selected_files: Optional[List[str]] = None,
    input_dir: str = str(OUTPUT_DIR),
    embed_model: str = DEFAULT_EMBED_MODEL,
    chunk_size: int = DEFAULT_CHUNK_SIZE,
    overlap: int = DEFAULT_CHUNK_OVERLAP,
    min_len: int = RAG_MIN_LEN,
    max_noise: float = RAG_MAX_NOISE,
):
    ensure_dirs()

    pack = build_rag_chunks(
        selected_files=selected_files,
        input_dir=input_dir,
        chunk_size=chunk_size,
        min_len=min_len,
        max_noise=max_noise,
    )

    if not pack["ids"]:
        return {"documents": pack["documents"], "chunks": 0, "indexed": 0}

    embeddings = embed_rag_chunks(pack["documents_text"], embed_model=embed_model)
    result = upsert_rag_index(
        ids=pack["ids"],
        documents=pack["documents_text"],
        metadatas=pack["metadatas"],
        embeddings=embeddings,
    )

    return {
        "documents": pack["documents"],
        "chunks": len(pack["documents_text"]),
        "indexed": result["indexed"],
    }




def append_benchmark_row(embed_model: str, gen_model: str, chunk_size: int, overlap: int, top_k: int, docs: int, chunks: int, q: str, answer: str, elapsed: float, source_count: int):
    ensure_dirs()
    row = pd.DataFrame(
        [
            {
                "ts": pd.Timestamp.now().isoformat(timespec="seconds"),
                "embed_model": embed_model,
                "gen_model": gen_model,
                "chunk_size": chunk_size,
                "overlap": overlap,
                "top_k": top_k,
                "docs": docs,
                "chunks": chunks,
                "question": q,
                "answer_len": len(answer or ""),
                "elapsed_sec": round(elapsed, 3),
                "source_count": source_count,
            }
        ]
    )
    if BENCH_CSV.exists():
        base = pd.read_csv(BENCH_CSV)
        out = pd.concat([base, row], ignore_index=True)
    else:
        out = row
    out.to_csv(BENCH_CSV, index=False)


def render_noise_bar(noise: float, usable: bool, level: str):
    color = score_to_color(noise)
    width = max(0, min(100, 100 - int(noise)))
    label = score_to_label(noise)
    usable_text = "사용 가능" if usable else "주의"
    st.markdown(
        f"""
        <div style="border:1px solid #ddd;border-radius:8px;padding:12px;margin:8px 0;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                <strong>{label}</strong>
                <span>{usable_text} · noise {noise:.1f}/100</span>
            </div>
            <div style="background:#eee;border-radius:999px;height:14px;overflow:hidden;">
                <div style="width:{width}%;background:{color};height:14px;"></div>
            </div>
            <div style="margin-top:6px;font-size:0.92em;color:#666;">level: {level}</div>
        </div>
        """,
        unsafe_allow_html=True,
    )


def init_chat_state():
    if "rag_chat" not in st.session_state:
        st.session_state["rag_chat"] = [{"role": "assistant", "content": "안녕하세요. 무엇을 찾고 있나요?"}]
    if "rag_input" not in st.session_state:
        st.session_state["rag_input"] = ""
    if "rag_mode" not in st.session_state:
        st.session_state["rag_mode"] = "hybrid"
    if "rag_show_context" not in st.session_state:
        st.session_state["rag_show_context"] = True


