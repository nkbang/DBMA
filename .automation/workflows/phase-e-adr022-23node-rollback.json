   {
    "parameters": {
     "jsCode": "const task = $('Extract Task JSON').item.json.task;\nconst required = [\n  'schema_version','task_id','title','owner','state','phase',\n  'requires_human_approval','production_mutation','evidence','audit'\n];\nconst errors = [];\n\nfor (const key of required) {\n  if (!(key in task)) errors.push(`missing field: ${key}`);\n}\nif (task.production_mutation !== false) {\n  errors.push('production_mutation must be false in PILOT phase');\n}\nif (typeof task.audit !== 'object' || !('status' in (task.audit||{}))) {\n  errors.push('audit structure invalid');\n}\nif (!Array.isArray(task.evidence)) {\n  errors.push('evidence must be an array');\n}\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    task\n  }\n}];"
    },
    "id": "validate-node",
    "name": "Code — Schema Validation",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [
     1000,
     -50
    ]
   },
   {
    "parameters": {
     "jsCode": "const valid = $json.valid;\nconst errors = $json.errors || [];\nconst task = $json.task;\nconst taskId = $('Webhook').item.json.body.task_id;\n\nconst bodyRaw = $('Webhook').item.json.body;\nconst payloadSignature = JSON.stringify(bodyRaw);\n\nlet evidenceRaw = '';\ntry {\n  evidenceRaw = $('Extract Evidence Text').item.json.evidence_raw || '';\n} catch (e) {\n  evidenceRaw = '';\n}\n\nconst lines = evidenceRaw.split('\\n').map(l => l.trim()).filter(l => l.length > 0);\nlet lastEntry = null;\nif (lines.length > 0) {\n  try {\n    lastEntry = JSON.parse(lines[lines.length - 1]);\n  } catch (e) {\n    lastEntry = null;\n  }\n}\n\nconst currentState = task.automation ? task.automation.state : null;\n\nconst executionId = $execution.id;\nconst transitionId = `${taskId}#${String(executionId).padStart(4, '0')}`;\n\nlet isConflict = false;\nlet isDuplicate = false;\n\nif (lastEntry && lastEntry.payload_signature === payloadSignature) {\n  isDuplicate = true;\n} else if (lastEntry && lastEntry.payload_signature !== payloadSignature && currentState) {\n  isConflict = true;\n}\n\nconst newState = valid ? 'VALIDATION_PASSED' : 'FAILED';\nconst failureCode = valid ? null : 'VALIDATION_FAILED';\n\nconst ALLOWED_FROM = {\n  VALIDATION_PASSED: [null, 'RECEIVED'],\n  FAILED: [null, 'RECEIVED', 'VALIDATION_PASSED']\n};\nconst isIllegalTransition = !!currentState && !(ALLOWED_FROM[newState] || []).includes(currentState);\n\nconst updatedTask = Object.assign({}, task, {\n  automation: {\n    state: newState,\n    failure_code: failureCode,\n    last_transition_id: transitionId\n  }\n});\n\nconst evidenceEntry = {\n  transition_id: transitionId,\n  task_id: taskId,\n  from: currentState || 'RECEIVED',\n  to: newState,\n  failure_code: failureCode,\n  actor: 'automation',\n  payload_signature: payloadSignature,\n  execution_id: executionId,\n  timestamp: new Date().toISOString(),\n  reason: valid ? 'schema validation passed' : errors.join('; ')\n};\n\nreturn [{\n  json: {\n    isConflict,\n    isDuplicate,\n    isIllegalTransition,\n    valid,\n    task_id: taskId,\n    currentState,\n    newState,\n    updatedTask,\n    evidenceLine: JSON.stringify(evidenceEntry),\n    evidenceLineWithNewline: JSON.stringify(evidenceEntry) + '\\n',\n    currentAutomation: task.automation || null,\n    transitionId,\n    failureCode\n  }\n}];"
    },
