{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DBMA: Streamlit Debug",
      "type": "debugpy",
      "request": "launch",
      "python": "/Users/David/envs/rag/bin/python",
      "module": "streamlit",
      "args": [
        "run",
        "dbma.py",
        "--server.headless",
        "true"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "redirectOutput": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
