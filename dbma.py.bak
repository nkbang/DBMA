# ─────────────────────────────────────────────
# 경로 상수
# ─────────────────────────────────────────────
BASE_DIR   = Path(__file__).resolve().parent
DATA_DIR   = BASE_DIR / "data"
RAW_DIR    = DATA_DIR / "RAW"
OUTPUT_DIR = DATA_DIR / "제련완성본"
QDRANT_DIR = BASE_DIR / "storage" / "qdrant_storage"
SUPPORTED_EXTS = {"pdf", "txt", "md", "docx", "epub", "html", "htm", "rtf"}

