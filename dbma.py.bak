# ─────────────────────────────────────────────
# 유틸
# ─────────────────────────────────────────────
def ensure_dirs() -> None:
    for d in (RAW_DIR, OUTPUT_DIR, QDRANT_DIR):
        d.mkdir(parents=True, exist_ok=True)


def scan_raw_files(target_dir: Path) -> List[Dict]:
    if not target_dir.exists():
        return []
    result = []
    for path in sorted(target_dir.iterdir()):
        if not path.is_file():
            continue
        ext = path.suffix.lower().lstrip(".")
        if ext in SUPPORTED_EXTS:
            s = path.stat()
            size_kb = s.st_size / 1024
            result.append({
                "name": path.name,
                "path": str(path),
                "ext": ext,
                "size": s.st_size,
                "size_str": f"{size_kb:.1f} KB" if size_kb < 1024 else f"{size_kb/1024:.1f} MB",
            })
    return result


def make_safe_stem(source_name: str) -> str:
    stem = Path(source_name).stem
    ext  = Path(source_name).suffix.lower().lstrip(".")
    safe = "".join(ch for ch in f"{stem}_{ext}" if ch.isalnum() or ch in "-_")
    return safe or "document"


def build_splitter(chunk_size: int, chunk_overlap: int) -> RecursiveCharacterTextSplitter:
    return RecursiveCharacterTextSplitter(
        chunk_size=chunk_size,
        chunk_overlap=chunk_overlap,
        separators=["\n\n", "\n", ". ", " ", ""],
    )


# ─────────────────────────────────────────────
# 노이즈 평가
# 핵심 원칙:
#   읽을 수 있는 텍스트(readable=True) → 낮은 점수 (0~18)
#   깨진 텍스트                         → 높은 점수 (0~100)
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# PDF 잔재 클리너 (노이즈 계산 전용)
# pypdf 폰트 매핑 실패 → U+E000-U+F8FF(PUA) + 제어문자 발생
# → weird_ratio 폭등 → score 100 고정 버그의 근본 원인
# ─────────────────────────────────────────────────────────
_RE_PUA        = re.compile(r"[\uE000-\uF8FF\U000F0000-\U000FFFFF]+")
_RE_CTRL       = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]")
_RE_NBSP       = re.compile(r"[\xa0\u00ad\u200b\u200c\u200d\ufeff]")
_RE_MULTIBLANK = re.compile(r"\n{3,}")

def _clean_for_noise(text: str) -> str:
    """노이즈 계산 전용 정규화 — 원본 final_text 는 건드리지 않는다."""
    t = _RE_PUA.sub("", text)
    t = _RE_CTRL.sub("", t)
    t = _RE_NBSP.sub(" ", t)
    t = t.replace("\x0c", "\n")
    t = _RE_MULTIBLANK.sub("\n\n", t)
    return t.strip()



# ─────────────────────────────────────────────────────────
# 청크 스팸/광고 필터 패턴
# Z-Library, Telegram 등 불법 PDF 배포 사이트가 삽입하는 홍보 텍스트 제거
# ─────────────────────────────────────────────────────────
_SPAM_PATTERNS = [
    r"z[\-]?lib(?:rary)?",          # z-library, zlibrary, z-lib
    r"z[\-]lib\.(?:gs|sk|fm|se)",  # z-lib.gs z-lib.sk 등
    r"official\s+telegram\s+channel",
    r"t\.me/",                       # Telegram 링크
    r"gateway\s+to\s+knowledge",   # Z-Library 슬로건
    r"libgen\.(?:is|rs|li)",         # Library Genesis
    r"sci[\-]?hub",                  # Sci-Hub
    r"bookzz\.org",
    r"b[\-]ok\.cc",
    r"epublibre\.org",
]
_SPAM_RE = re.compile(
    "|".join(_SPAM_PATTERNS),
    re.IGNORECASE,
)

def _is_spam_chunk(text: str) -> bool:
    """Z-Library 등 광고/스팸 패턴이 포함된 청크 감지."""
    return bool(_SPAM_RE.search(text))

_ALLOWED_PUNCT = frozenset(
    ".,;:!?()[]{}'\"-_/\\&%*@#=+~`|<>\u2013\u2014\u201c\u201d\u2018\u2019\u2026"
)

def calculate_noise_score(text: str, file_type: str, is_ocr: bool = False) -> Dict:
    """
    텍스트 품질을 0-100 점수로 평가한다.
      readable=True  -> 0-18  (정상 학술·도서 텍스트)
      readable=False -> 0-100 (스캔 OCR, 손상 파일 등)

    BUG FIX — score 100 고정 원인 해결:
      1) _clean_for_noise() 로 PUA·제어문자 제거 후 계산
      2) readable 임계값 완화 (avg_word_len >= 2.0, weird < 0.06)
      3) sentence_hint >= 3 (짧은 섹션 허용)
    """
    cleaned = (text or "").replace("\r\n", "\n").replace("\r", "\n").strip()
    calc    = _clean_for_noise(cleaned)   # 노이즈 계산 전용 사본

    lines  = [ln.strip() for ln in calc.splitlines() if ln.strip()]
    words  = calc.split()
    total  = len(calc)

    weird = (
        sum(1 for ch in calc
            if not (ch.isalnum() or ch.isspace() or ch in _ALLOWED_PUNCT))
        / total
    ) if total else 0.0

    short_ln  = sum(1 for ln in lines if len(ln) <= 2)      / len(lines) if lines else 0.0
    frag_ln   = sum(1 for ln in lines if 3 <= len(ln) <= 8) / len(lines) if lines else 0.0
    rep_punct = (
        sum(1 for i in range(total - 2)
            if calc[i] == calc[i+1] == calc[i+2]
            and not calc[i].isalnum() and not calc[i].isspace())
        / total
    ) if total > 2 else 0.0

    avg_word_len   = sum(len(w) for w in words) / len(words) if words else 0.0
    sentence_hints = sum(1 for ch in calc if ch in ".!?")

    # readable 판정 (학술 PDF / 원어 인용 수용을 위해 임계값 완화)
    readable = (
        total           >= 300
        and len(words)  >= 40
        and avg_word_len >= 2.0
        and sentence_hints >= 3
        and weird        < 0.06
    )

    if readable:
        score = round(
            min(18.0,
                weird * 120
                + short_ln * 5
                + frag_ln  * 4
                + (2 if is_ocr else 0)),
            2,
        )
    else:
        score = round(
            min(100.0,
                weird     * 1200
                + short_ln * 20
                + frag_ln  * 12
                + rep_punct * 800
                + (6 if is_ocr else 0)),
            2,
        )

    mode = "pdf_ocr" if file_type == "pdf" and is_ocr else file_type
    return {
        "score":    score,
        "mode":     mode,
        "cleaned_text": cleaned,          # 원본 유지 — chunking 에 사용
        "readable": readable,
        "symbol_ratio":         round(weird     * 100, 2),
        "short_line_ratio":     round(short_ln  * 100, 2),
        "broken_line_ratio":    round(frag_ln   * 100, 2),
        "repeated_punct_ratio": round(rep_punct * 100, 2),
        "ocr_noise_ratio":      5.0 if is_ocr else 0.0,
        "footnote_ratio":       0.0,
        "avg_word_len":         round(avg_word_len, 2),
        "sentence_hint_count":  sentence_hints,
        "symbol_ratio_raw":         weird,
        "short_line_ratio_raw":     short_ln,
        "broken_line_ratio_raw":    frag_ln,
        "repeated_punct_ratio_raw": rep_punct,
    }

def build_doc_meta(
    src_path: str,
    source_name: str,
    stem: str,
    source_type: str,
    full_text: str,
    chunks: List[str],
    noise: Dict,
    chunk_size: int,
    chunk_overlap: int,
    use_ocr: bool,
) -> Dict:
    is_korean = any("\uAC00" <= ch <= "\uD7A3" for ch in full_text)
    return {
        "schema_version": "1.0.0",
        "doc_id":         f"doc_{stem}",
        "stem":           stem,
        "source_name":    source_name,
        "source_path":    src_path,
        "source_type":    source_type,
        "source_ext":     Path(source_name).suffix.lower(),
        "created_at":     "",
        "updated_at":     "",
        "content_hash":   f"len:{len(full_text)}",
        "pipeline": {
            "producer":         "dbma.py",
            "producer_version": "1.0.0",
            "ocr_used":         use_ocr if source_type == "pdf" else False,
            "chunk_size":       chunk_size,
            "chunk_overlap":    chunk_overlap,
            "chunk_strategy":   "recursive_character_text_splitter",
        },
        "quality": {
            "noise_score":          noise["score"],
            "noise_mode":           noise["mode"],
            "noise_status":         "양호" if noise["score"] < 35 else "주의",
            "readable":             noise["readable"],
            "symbol_ratio":         noise["symbol_ratio"],
            "short_line_ratio":     noise["short_line_ratio"],
            "broken_line_ratio":    noise["broken_line_ratio"],
            "repeated_punct_ratio": noise["repeated_punct_ratio"],
            "ocr_noise_ratio":      noise["ocr_noise_ratio"],
            "footnote_ratio":       noise["footnote_ratio"],
            "avg_word_len":         noise["avg_word_len"],
            "sentence_hint_count":  noise["sentence_hint_count"],
        },
        "language": {
            "primary":  "ko" if is_korean else "en",
            "detected": ["ko"] if is_korean else ["en"],
            "note":     "auto-detected",
        },
        "stats": {
            "char_count":      len(full_text),
            "word_count":      len(full_text.split()),
            "line_count":      len(full_text.splitlines()),
            "paragraph_count": len([p for p in full_text.split("\n\n") if p.strip()]),
            "chunk_count":     len(chunks),
        },
        "paths": {
            "md":          f"{stem}.md",
            "chunks_txt":  f"{stem}_chunks.txt",
            "doc_json":    f"{stem}_doc.json",
            "chunks_jsonl": f"{stem}_chunks.jsonl",
        },
        "tags":  [],
        "notes": "",
    }


# ─────────────────────────────────────────────
# 청크 레코드 빌더
# ─────────────────────────────────────────────
def build_chunk_records(doc_meta: Dict, chunks: List[str], min_chunk_len: int = 80) -> List[Dict]:
    records = []
    total   = len(chunks)
    for i, text in enumerate(chunks, start=1):
        text = text.strip()
        if not text:
            continue
        heading = text.splitlines()[0][:60] if text.splitlines() else None
        records.append({
            "schema_version": doc_meta["schema_version"],
            "doc_id":         doc_meta["doc_id"],
            "chunk_id":       f"{doc_meta['doc_id']}__{i:04d}",
            "stem":           doc_meta["stem"],
            "source_name":    doc_meta["source_name"],
            "source_type":    doc_meta["source_type"],
            "chunk_index":    i,
            "total_chunks":   total,
            "char_count":     len(text),
            "token_estimate": max(1, len(text) // 4),
            "text":           text,
            "text_hash":      f"len:{len(text)}",
            "quality": {
                "doc_noise_score":  doc_meta["quality"]["noise_score"],
                "doc_noise_status": doc_meta["quality"]["noise_status"],
            },
            "language": doc_meta["language"],
            "anchors": {
                "page_start": None,
                "page_end":   None,
                "section":    None,
                "heading":    heading,
            },
            "indexing": {
                "eligible":      len(text) >= min_chunk_len and not _is_spam_chunk(text),
                "exclude_reason": (
                    "spam" if _is_spam_chunk(text)
                    else ("" if len(text) >= min_chunk_len else f"too_short:{len(text)}")
                ),
            },
            "created_at": doc_meta["created_at"],
        })
    return records


# ─────────────────────────────────────────────
# 저장 함수
# ─────────────────────────────────────────────
def save_md(output_dir: Path, doc_meta: Dict, full_text: str) -> Path:
    path = output_dir / f"{doc_meta['stem']}.md"
    frontmatter = "\n".join([
        "---",
        f"doc_id: {doc_meta['doc_id']}",
        f"source: {doc_meta['source_name']}",
        f"source_type: {doc_meta['source_type']}",
        f"noise_score: {doc_meta['quality']['noise_score']}",
        f"readable: {doc_meta['quality']['readable']}",
        f"chunk_count: {doc_meta['stats']['chunk_count']}",
        "---",
        "",
    ])
    path.write_text(frontmatter + full_text.strip() + "\n", encoding="utf-8")
    return path


def save_chunks_txt(output_dir: Path, doc_meta: Dict, chunk_records: List[Dict]) -> Path:
    path = output_dir / f"{doc_meta['stem']}_chunks.txt"
    n    = len(chunk_records)
    lines = [
        f"source: {doc_meta['source_name']}",
        f"total_chunks: {n}",
        "",
    ]
    for rec in chunk_records:
        lines.append(f"════ CHUNK {rec['chunk_index']:03d}/{n:03d} ════")
        lines.append(rec["text"])
        lines.append("")
    path.write_text("\n".join(lines).strip() + "\n", encoding="utf-8")
    return path


def save_doc_json(output_dir: Path, doc_meta: Dict) -> Path:
    path = output_dir / f"{doc_meta['stem']}_doc.json"
    path.write_text(json.dumps(doc_meta, ensure_ascii=False, indent=2), encoding="utf-8")
    return path


def save_chunks_jsonl(output_dir: Path, chunk_records: List[Dict]) -> Path:
    if not chunk_records:
        raise ValueError("chunk_records 비어 있음")
    path = output_dir / f"{chunk_records[0]['stem']}_chunks.jsonl"
    with path.open("w", encoding="utf-8") as f:
        for rec in chunk_records:
            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    return path


# ─────────────────────────────────────────────
# 핵심 처리 함수
# 반환: (result_dict, debug_lines)
# ─────────────────────────────────────────────
def process_one_file(
    file_info: Dict,
    splitter: RecursiveCharacterTextSplitter,
    output_dir: Path,
) -> Tuple[Dict, List[str]]:
    src_path    = file_info["path"]
    source_name = file_info["name"]
    ext         = file_info["ext"]
    stem        = make_safe_stem(source_name)
    debug: List[str] = []

    # ── 1. 파일 정보 로그 ────────────────────────
    debug.append(f"[FILE] {source_name} | ext={ext} | size={file_info['size_str']}")
    debug.append(f"[CHUNK_CFG] size={splitter._chunk_size} | overlap={splitter._chunk_overlap}")

    # ── 2. 텍스트 추출 ───────────────────────────
    extract_result = extract_text_from_file(src_path, ext)
    raw_text       = (extract_result.get("text") or "").strip()
    detected_type  = extract_result.get("file_type", ext)
    is_ocr         = bool(extract_result.get("is_ocr", False))

    debug.append(
        f"[EXTRACT] type={detected_type} | ocr={is_ocr} | chars={len(raw_text):,} | lines={len(raw_text.splitlines()):,}"
    )
    preview = raw_text[:300].replace("<", "&lt;").replace("\n", " / ")
    debug.append(f"[PREVIEW] {preview}")

    if not raw_text:
        raise ValueError(f"본문 추출 실패 (빈 텍스트): {source_name}")

    # ── 3. 노이즈 평가 ───────────────────────────
    noise      = calculate_noise_score(raw_text, detected_type, is_ocr=is_ocr)
    final_text = noise["cleaned_text"] or raw_text  # strip된 원본

    debug.append(
        f"[NOISE] score={noise['score']} | readable={noise['readable']} "
        f"| avg_word_len={noise['avg_word_len']} | sentence_hints={noise['sentence_hint_count']} "
        f"| symbol={noise['symbol_ratio']}% | short_ln={noise['short_line_ratio']}% "
        f"| frag_ln={noise['broken_line_ratio']}% | rep_punct={noise['repeated_punct_ratio']}%"
    )
    if noise["score"] >= 35:
        debug.append(f"[NOISE_WARN] noise_score={noise['score']} ≥ 35 → 텍스트 품질 주의")

    # ── 4. 청킹 ─────────────────────────────────
    raw_chunks    = splitter.split_text(final_text)
    chunks        = [c.strip() for c in raw_chunks if c and c.strip()]
    chunk_lengths = [len(c) for c in chunks]
    avg_cl        = round(sum(chunk_lengths) / len(chunk_lengths), 1) if chunk_lengths else 0

    debug.append(
        f"[CHUNKS] count={len(chunks)} | min={min(chunk_lengths) if chunk_lengths else 0} "
        f"| max={max(chunk_lengths) if chunk_lengths else 0} | avg={avg_cl}"
    )
    if chunks:
        debug.append(f"[CHUNK_01] {chunks[0][:200].replace('<','&lt;').replace(chr(10),' / ')}")
        debug.append(f"[CHUNK_LAST] {chunks[-1][:200].replace('<','&lt;').replace(chr(10),' / ')}")

    if not chunks:
        raise ValueError(f"청크 생성 실패 (0개): {source_name}")

    # ── 5. 메타 & 레코드 빌드 ────────────────────
    doc_meta      = build_doc_meta(
        src_path=src_path, source_name=source_name, stem=stem,
        source_type=detected_type, full_text=final_text, chunks=chunks,
        noise=noise, chunk_size=splitter._chunk_size,
        chunk_overlap=splitter._chunk_overlap, use_ocr=is_ocr,
    )
    chunk_records = build_chunk_records(doc_meta, chunks)
    eligible_count = sum(1 for r in chunk_records if r["indexing"]["eligible"])
    skipped_count  = len(chunk_records) - eligible_count
    if skipped_count:
        debug.append(f"[CHUNK_FILTER] 총={len(chunk_records)} | eligible={eligible_count} | 너무짧아 제외={skipped_count}")

    # ── 6. 저장 ─────────────────────────────────
    md_path        = save_md(output_dir, doc_meta, final_text)
    chunks_txt_path = save_chunks_txt(output_dir, doc_meta, chunk_records)
    doc_json_path  = save_doc_json(output_dir, doc_meta)
    jsonl_path     = save_chunks_jsonl(output_dir, chunk_records)

    debug.append(
        f"[SAVE] md={md_path.name} | json={doc_json_path.name} | jsonl={jsonl_path.name}"
    )

    return {
        "source_name": source_name,
        "doc_id":      doc_meta["doc_id"],
        "chunk_count": len(chunk_records),
        "noise_score": doc_meta["quality"]["noise_score"],
        "readable":    doc_meta["quality"]["readable"],
        "paths": {
            "md":          str(md_path),
            "chunks_txt":  str(chunks_txt_path),
            "doc_json":    str(doc_json_path),
            "chunks_jsonl": str(jsonl_path),
        },
    }, debug


# ─────────────────────────────────────────────
# UI 렌더러
# ─────────────────────────────────────────────
def render_hero() -> None:
    st.markdown("""
<div class="hero">
    <h1>DBMA</h1>
    <p>문서 제련 · 구조화 저장 · 벡터 인덱싱 · 의미 검색 — 개인용 RAG 워크스테이션</p>
</div>""", unsafe_allow_html=True)


def render_metric(label: str, value: str, sub: str) -> None:
    st.markdown(f"""
<div class="metric-card">
    <div class="metric-label">{label}</div>
    <div class="metric-value">{value}</div>
    <div class="metric-sub">{sub}</div>
</div>""", unsafe_allow_html=True)


def render_file_selector(files: List[Dict]) -> List[Dict]:
    selected: List[Dict] = []

    if "select_all_files" not in st.session_state:
        st.session_state["select_all_files"] = False

    def _apply_all():
        flag = st.session_state.get("select_all_files", False)
        for f in files:
            st.session_state[f"sel::{f['path']}"] = flag

    st.checkbox("전체 선택", key="select_all_files", on_change=_apply_all)
    st.caption(f"선택 가능: {len(files)}개 파일")

    hdr = st.columns([0.06, 0.44, 0.12, 0.14, 0.24])
    for col, label in zip(hdr, ["✓", "파일명", "형식", "크기", "폴더"]):
        col.markdown(f"**{label}**")

    for f in files:
        key = f"sel::{f['path']}"
        st.session_state.setdefault(key, False)
        cols = st.columns([0.06, 0.44, 0.12, 0.14, 0.24])
        with cols[0]:
            checked = st.checkbox("", key=key, label_visibility="collapsed")
        cols[1].markdown(f"<div class='file-row'>{f['name']}</div>", unsafe_allow_html=True)
        cols[2].markdown(f"<div class='file-row'>{f['ext']}</div>", unsafe_allow_html=True)
        cols[3].markdown(f"<div class='file-row'>{f['size_str']}</div>", unsafe_allow_html=True)
        cols[4].markdown(f"<div class='file-row'>{Path(f['path']).parent.name}</div>", unsafe_allow_html=True)
        if checked:
            selected.append(f)

    return selected


# ─────────────────────────────────────────────
# main
# ─────────────────────────────────────────────
def main() -> None:
    ensure_dirs()
    inject_modern_css()
    render_hero()

    # ── 사이드바 ────────────────────────────────
    with st.sidebar:
        st.subheader("⚙️ 제어판")
        target_dir   = Path(st.text_input("RAW 폴더",   value=str(RAW_DIR)))
        output_dir   = Path(st.text_input("출력 폴더",  value=str(OUTPUT_DIR)))
        qdrant_dir   = Path(st.text_input("벡터 저장소", value=str(QDRANT_DIR)))
        chunk_size   = st.slider("Chunk Size",    300, 3000, 1200, 100)
        chunk_overlap = st.slider("Chunk Overlap",  0,  600,  150,  10)
        top_k        = st.slider("검색 결과 수",   1,   20,    5,   1)
        rebuild_index = st.checkbox("인덱스 재생성", value=False)
        run_index    = st.button("▶ RAG 인덱싱 실행", use_container_width=True)

    for d in (target_dir, output_dir, qdrant_dir):
        d.mkdir(parents=True, exist_ok=True)

    rag   = DBMARag(output_dir=output_dir, qdrant_dir=qdrant_dir)
    files = scan_raw_files(target_dir)
    stats = rag.stats()

    # ── 대시보드 메트릭 ──────────────────────────
    c1, c2, c3, c4 = st.columns(4)
    with c1: render_metric("RAW 문서",    str(len(files)),                     "처리 대기 파일")
    with c2: render_metric("JSONL 파일",  str(stats.get("chunks_jsonl_files", 0)), "저장된 청크 파일")
    with c3: render_metric("벡터 포인트", str(stats.get("points_count") or 0),   "Qdrant 컬렉션")
    with c4: render_metric("임베딩 모델", "MiniLM",                             "384차원")

    tab1, tab2, tab3 = st.tabs(["📄 처리", "🔗 RAG", "🔍 검색"])

    # ────────── 탭 1: 처리 ──────────────────────
    with tab1:
        st.markdown('<div class="panel">', unsafe_allow_html=True)
        st.subheader("문서 처리")

        selected_files: List[Dict] = []
        if files:
            selected_files = render_file_selector(files)
            st.caption(f"현재 선택: **{len(selected_files)}개** | 청킹: size={chunk_size}, overlap={chunk_overlap}")
        else:
            st.info("RAW 폴더에 지원 파일이 없습니다.")

        run_parse = st.button("▶ 처리 시작", use_container_width=True, type="primary")

        if run_parse:
            if not selected_files:
                st.warning("처리할 파일을 먼저 선택하세요.")
                st.markdown('</div>', unsafe_allow_html=True)
                return

            splitter = build_splitter(chunk_size, chunk_overlap)
            logs: List[str] = []
            results: List[Dict] = []
            progress = st.progress(0.0)
            total_n  = len(selected_files)

            for idx, file_info in enumerate(selected_files, start=1):
                try:
                    res, debug_lines = process_one_file(file_info, splitter, output_dir)
                    noise_tag = "🟢" if res["noise_score"] < 20 else ("🟡" if res["noise_score"] < 35 else "🔴")
                    logs.append(
                        f'<div class="log-ok">[OK] {res["source_name"]} '
                        f'| chunks={res["chunk_count"]} '
                        f'| noise={res["noise_score"]} {noise_tag} '
                        f'| readable={res["readable"]}</div>'
                    )
                    for line in debug_lines:
                        css_cls = "log-warn" if line.startswith("[NOISE_WARN]") or line.startswith("[FAIL]") else "log-info"
                        logs.append(f'<div class="{css_cls}">{line}</div>')
                    results.append(res)
                except Exception as exc:
                    tb = traceback.format_exc().replace("<", "&lt;")
                    logs.append(f'<div class="log-warn">[FAIL] {file_info["name"]} | {exc}</div>')
                    logs.append(f'<div class="log-warn"><pre>{tb}</pre></div>')
                progress.progress(idx / total_n)

            st.markdown('<div class="log-box">' + "".join(logs) + '</div>', unsafe_allow_html=True)
            if results:
                st.success(f"✅ {len(results)} / {total_n}개 문서 처리 완료")
                st.json(results)
            if len(results) < total_n:
                st.error(f"⚠️ {total_n - len(results)}개 실패 — 위 로그 확인")

        st.markdown('</div>', unsafe_allow_html=True)

    # ────────── 탭 2: RAG ───────────────────────
    with tab2:
        st.markdown('<div class="panel">', unsafe_allow_html=True)
        st.subheader("RAG 인덱싱")
        st.json(rag.stats())
        if run_index:
            if rebuild_index:
                rag.reset_collection()
            idx_results = rag.upsert_all_chunks()
            total_upserted = sum(r.get("upserted", 0) for r in idx_results)
            st.success(f"✅ {total_upserted}개 청크 업서트 완료")
            st.json(idx_results)
        st.markdown('</div>', unsafe_allow_html=True)

    # ────────── 탭 3: 검색 ──────────────────────
    with tab3:
        st.markdown('<div class="panel">', unsafe_allow_html=True)
        st.subheader("의미 검색")
        query  = st.text_input("질문", value="이 문서들의 핵심 주제는 무엇인가?")
        sf     = st.selectbox("형식 필터", ["", "pdf", "txt", "md", "docx", "epub", "html", "rtf"])

        if st.button("🔍 검색 실행", use_container_width=True):
            search_results = rag.search(query=query, limit=top_k, source_type=sf or None)
            context        = build_context(search_results)

            left, right = st.columns([1.2, 1])
            with left:
                st.caption(f"{len(search_results)}개 결과")
                for item in search_results:
                    st.markdown(f"""
<div class="result-card">
    <b>{item['source_name']}</b><br>
    score: {round(item['score'], 4)} | chunk: {item['chunk_index']}<br><br>
    {item['text'][:600].replace('<', '&lt;')}
</div>""", unsafe_allow_html=True)
            with right:
                st.caption("컨텍스트 (RAG 입력용)")
                st.markdown(
                    '<div class="context-box">' + context.replace('<', '&lt;') + '</div>',
                    unsafe_allow_html=True,
                )

        st.markdown('</div>', unsafe_allow_html=True)


if __name__ == "__main__":
    main()
